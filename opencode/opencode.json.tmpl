{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "jean-claude": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Jean Claude (local Ollama)",
      "options": { "baseURL": "__OLLAMA_URL__/v1" },
      "models": {
        "__MODEL__": {
          "name": "Jean Claude — Qwen3-Coder-30B-A3B Q5_K_M",
          "limit": { "context": __NUM_CTX__, "output": 8192 }
        },
        "__SMALL_MODEL__": {
          "name": "Jean Claude helper (titles, summaries)",
          "limit": { "context": __NUM_CTX__, "output": 2048 }
        }
      }
    }
  },
  "enabled_providers": ["jean-claude"],
  "model": "jean-claude/__MODEL__",
  "small_model": "jean-claude/__SMALL_MODEL__",
  "share": "disabled",
  "autoupdate": "notify",
  "lsp": true,
  "compaction": { "auto": true, "prune": true, "reserved": 8192 },
  "watcher": {
    "ignore": ["node_modules/**", ".venv/**", "venv/**", "dist/**", "build/**", "target/**",
               ".git/**", "__pycache__/**", ".pytest_cache/**", ".mypy_cache/**", "coverage/**"]
  },
  "agent": {
    "build": { "temperature": 0.7, "top_p": 0.8 },
    "plan": {
      "temperature": 0.5,
      "top_p": 0.8,
      "permission": { "edit": "deny", "run_tests_sandboxed": "allow" }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "deny",
    "task": "deny",
    "run_tests_sandboxed": "allow",
    "sandbox_setup": "ask",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "pytest*": "deny",
      "python -m pytest*": "deny",
      "python3 -m pytest*": "deny",
      "tox*": "deny",
      "npm test*": "deny",
      "npm run test*": "deny",
      "pnpm test*": "deny",
      "yarn test*": "deny",
      "npx jest*": "deny",
      "npx vitest*": "deny",
      "go test*": "deny",
      "cargo test*": "deny",
      "make test*": "deny",
      "git push*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}
