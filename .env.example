# ─── Jean Claude configuration ─────────────────────────────────────────────
# Copy to .env (scripts/setup.sh does this and fills in the secrets/GIDs).

# Backend overlay. One of:
#   docker-compose.yml:compose/gpu-vulkan.yml   <- default, Radeon 890M via Vulkan (Linux)
#   docker-compose.yml:compose/gpu-rocm.yml     <- Radeon 890M via ROCm (Linux)
#   docker-compose.yml                          <- CPU only (12 Zen 5 cores)
#   docker-compose.yml:compose/native-ollama.yml <- Ollama installed on host (Windows/macOS)
COMPOSE_FILE=docker-compose.yml:compose/gpu-vulkan.yml
# Use ":" between files on every OS (Docker Desktop on Windows defaults to ";")
COMPOSE_PATH_SEPARATOR=:

# ─── Model ────────────────────────────────────────────────────────────────
# Unsloth GGUF, Q5_K_M = 21.7 GB. (Ollama's library only ships q4_K_M/q8_0/fp16 for this model.)
JC_BASE_MODEL=hf.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q5_K_M
JC_MODEL_NAME=jean-claude
# Context window. With a q8_0 KV cache this model costs ~48 KiB/token:
#   32768 -> ~1.6 GB   65536 -> ~3.2 GB   131072 -> ~6.4 GB   (model native max: 262144)
JC_NUM_CTX=65536
# CPU threads: leave empty for GPU backends; 12 (physical cores) for CPU-only.
JC_NUM_THREAD=
# Layers to offload to GPU: empty = let Ollama decide. 999 = force everything onto the iGPU.
JC_NUM_GPU=
# Prompt batch size: empty = Ollama default (512). Larger (1024/2048) can speed up
# prompt processing on iGPUs; pick with: ./scripts/bench.sh --batch "512 1024 2048"
JC_NUM_BATCH=
# 1 = re-pull the base GGUF on next start (to pick up upstream fixes)
JC_UPDATE_BASE=0
# 1 = load the model into memory right after creating it, so the first chat is instant
JC_PRELOAD=1

# ─── Ollama runtime ───────────────────────────────────────────────────────
OLLAMA_TAG=latest
OLLAMA_ROCM_TAG=rocm
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_LOAD_TIMEOUT=15m
OLLAMA_DEBUG=0
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434
GGML_VK_VISIBLE_DEVICES=0

# Host group IDs for /dev/dri access (setup.sh detects these)
VIDEO_GID=44
RENDER_GID=992

# ─── Open WebUI ───────────────────────────────────────────────────────────
OPEN_WEBUI_TAG=main
WEBUI_BIND=0.0.0.0
WEBUI_PORT=3000
WEBUI_ENABLE_SIGNUP=True
WEBUI_SECRET_KEY=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
